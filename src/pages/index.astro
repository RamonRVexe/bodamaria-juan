---
import Layout from '@/layouts/Layout.astro';
import Hero from '@/components/Hero.astro';
import Envelope from '@/components/Envelope.astro';
import RSVPForm from '@/components/RSVPForm.astro';
---

<Layout>
  <Hero />

  <section class="scene">
    <Envelope />
  </section>

  <section class="rsvp-section">
    <RSVPForm />
  </section>
</Layout>

<style>
.scene{
    position:relative;

    min-height:220vh;

    margin-top:clamp(8rem,18vw,14rem);

    padding-block:
        clamp(10rem,18vw,14rem)
        clamp(5rem,12vw,8rem);
}

  .rsvp-section {
    position: relative;
    z-index: 1;
    margin-top: clamp(6rem, 10vw, 10rem);
    padding-block: clamp(3rem, 6vw, 5rem) clamp(5rem, 12vw, 8rem);
  }
</style>
