---
import { wedding } from '@/config/wedding';
---

<div class="envelope-container">
    <div class="envelope" data-envelope>

        <!-- HALO / SOMBRA AMBIENTAL -->
        <div class="envelope__ambient"></div>

        <!-- CARTA -->
        <div class="envelope__letter">

            <div class="envelope__paper">

                <div class="envelope__paper-texture"></div>

                <svg class="envelope__ornament envelope__ornament--top" viewBox="0 0 120 24" xmlns="http://www.w3.org/2000/svg">
                    <path d="M2 12 C 30 2, 45 22, 60 12 C 75 2, 90 22, 118 12"
                          fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round"/>
                    <circle cx="60" cy="12" r="2.2" fill="currentColor"/>
                </svg>

                <p class="envelope__text envelope__text--intro">
                    <span class="envelope__dropcap">{wedding.story.introLine?.charAt(0)}</span>{wedding.story.introLine?.slice(1)}
                </p>

                <p class="envelope__text envelope__text--body1">
                    {wedding.story.bodyLine1}
                </p>

                <p class="envelope__text envelope__text--body2">
                    {wedding.story.bodyLine2}
                </p>

                <div class="envelope__paper-line">
                    <span></span>
                    <svg viewBox="0 0 10 10" class="envelope__paper-line-dot" xmlns="http://www.w3.org/2000/svg">
                        <circle cx="5" cy="5" r="2.5" fill="currentColor"/>
                    </svg>
                    <span></span>
                </div>

                <div class="envelope__paper-corner envelope__paper-corner--tl"></div>
                <div class="envelope__paper-corner envelope__paper-corner--tr"></div>
                <div class="envelope__paper-corner envelope__paper-corner--bl"></div>
                <div class="envelope__paper-corner envelope__paper-corner--br"></div>

            </div>

        </div>

        <!-- CUERPO DEL SOBRE -->
        <div class="envelope__body">
            <div class="envelope__texture"></div>
            <div class="envelope__side envelope__side--left"></div>
            <div class="envelope__side envelope__side--right"></div>
            <div class="envelope__pocket-shadow"></div>
            <div class="envelope__inner-shadow"></div>
            <div class="envelope__rim"></div>
        </div>

        <!-- SOLAPA -->
        <div class="envelope__flap">
            <div class="envelope__flap-inner"></div>
            <div class="envelope__flap-edge"></div>
        </div>

        <!-- SELLO -->
        <div class="envelope__seal">
            <div class="envelope__seal-drip"></div>
            <svg class="envelope__seal-ring" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
                <circle cx="50" cy="50" r="45" fill="none" stroke="rgba(255,245,222,0.35)" stroke-width="1.2" stroke-dasharray="2 4"/>
            </svg>
            <span>M&amp;J</span>
            <div class="envelope__seal-crack"></div>
        </div>

        <!-- BRILLO DE SUELO -->
        <div class="envelope__floor-glow"></div>

    </div>
</div>

<style>

.envelope-container {
    position: sticky;
    top: 0;
    height: 100svh;

    display: grid;
    place-items: center;

    overflow: hidden;

    background:
        radial-gradient(ellipse 70% 55% at 50% 38%, rgba(180, 138, 90, 0.10), transparent 70%);
}

.envelope {

    --progress: 0;

    --envelope-left: 8%;
    --envelope-width: 84%;
    --envelope-height: 78%;

    position: relative;

    width: min(460px, calc(100vw - 2rem));
    height: clamp(420px, 108vw, 560px);

    perspective: 1600px;
    perspective-origin: center 30%;

    isolation: isolate;

    transform-style: preserve-3d;

    cursor: pointer;

    outline: none;

}

.envelope:focus-visible {

    box-shadow: 0 0 0 3px rgba(180, 138, 90, 0.35);

    border-radius: 10px;

}

.envelope:hover .envelope__letter {

    filter: brightness(1.015);

}

.envelope:active {

    transform: scale(0.995);

}

/* ========================================
   HALO AMBIENTAL
======================================== */

.envelope__ambient {

    position: absolute;

    inset: -15%;

    background:
        radial-gradient(
            circle at 50% 45%,
            rgba(212, 175, 130, calc(0.22 * var(--progress))),
            transparent 62%
        );

    filter: blur(18px);

    pointer-events: none;

    z-index: 0;

    transition: opacity 0.6s ease;

}

.envelope__floor-glow {

    position: absolute;

    left: 50%;
    bottom: -6%;

    width: 70%;
    height: 24px;

    background: radial-gradient(ellipse, rgba(80, 55, 25, 0.28), transparent 72%);

    transform:
        translateX(-50%)
        scaleX(calc(0.85 + 0.25 * var(--progress)));

    opacity: calc(0.5 + 0.5 * var(--progress));

    filter: blur(2px);

    pointer-events: none;

    z-index: 0;

    transition: transform 0.6s ease, opacity 0.6s ease;

}

/* ========================================
   CARTA
======================================== */

.envelope__letter {

    position: absolute;

    top: 0;
    left: var(--envelope-left);

    width: var(--envelope-width);
    height: var(--envelope-height);

    padding: clamp(1.3rem, 5.2vw, 2.1rem);

    box-sizing: border-box;

    background:
        linear-gradient(
            135deg,
            #fffdf9 0%,
            #fbf8f0 52%,
            #f3ecdc 100%
        );

    border: 1px solid rgba(160, 130, 90, 0.16);

    border-radius: 4px;

    z-index: 1;

    box-shadow:
        0 1px 0 rgba(255, 255, 255, 0.6) inset,
        0 8px 12px rgba(60, 40, 20, calc(0.03 + 0.02 * var(--progress))),
        0 calc(20px + 25px * var(--progress)) calc(45px + 30px * var(--progress)) rgba(40, 25, 15, calc(0.12 + 0.1 * var(--progress)));

    transform:

        translateY(
            calc(
                26% - (38% * var(--progress))
            )
        )

        translateZ(
            calc(
                1px + (38px * var(--progress))
            )
        )

        rotateZ(0deg)

        rotateX(
            calc(
                2deg - (2deg * var(--progress))
            )
        );

    transition:
        box-shadow 0.5s ease;

    will-change: transform;

}

/* Transiciones suaves solo cuando la apertura/cierre se dispara por click o teclado
   (el scroll mueve --progress fotograma a fotograma y no necesita easing extra) */

.envelope.is-animating .envelope__letter,
.envelope.is-animating .envelope__paper,
.envelope.is-animating .envelope__flap,
.envelope.is-animating .envelope__seal {

    transition:
        transform 0.85s cubic-bezier(.22, 1, .36, 1),
        opacity 0.6s ease,
        box-shadow 0.6s ease,
        filter 0.6s ease;

}

/* Borde interior del papel */

.envelope__letter::before {

    content: '';

    position: absolute;

    inset: 9px;

    border: 1px solid rgba(180, 138, 90, 0.24);

    border-radius: 3px;

    pointer-events: none;

}

.envelope__letter::after {

    content: '';

    position: absolute;

    inset: 0;

    border-radius: 4px;

    background: linear-gradient(180deg, rgba(80, 55, 30, calc(0.16 * (1 - var(--progress)))), transparent 22%);

    pointer-events: none;

    transition: background 0.5s ease;

}

/* ========================================
   PAPEL INTERNO
======================================== */

.envelope__paper {

    position: relative;

    height: 100%;

    display: flex;
    flex-direction: column;
    justify-content: center;

    opacity:

        clamp(
            0,
            calc(
                (var(--progress) - .28) * 1.55
            ),
            1
        );

    transform:

        translateY(
            calc(
                38px - (38px * var(--progress))
            )
        )

        scale(
            calc(
                .96 + (.04 * var(--progress))
            )
        );

    transition:
        opacity 0.55s ease,
        transform 0.8s cubic-bezier(.22, 1, .36, 1);

}

.envelope__paper-texture {

    position: absolute;

    inset: 0;

    opacity: 0.5;

    mix-blend-mode: multiply;

    pointer-events: none;

    background-image:
        radial-gradient(rgba(150, 115, 75, 0.045) 1px, transparent 1px);
    background-size: 3px 3px;

}

.envelope__ornament {

    display: block;

    width: 78px;

    height: auto;

    margin: 0 auto 0.9rem;

    color: #b48a5a;

    opacity: 0.7;

}

.envelope__dropcap {

    font-size: 1.5em;

    line-height: 0.7;

    padding-right: 0.05em;

    font-style: normal;

    color: #b66d3d;

}

/* Línea decorativa inferior */

.envelope__paper-line {

    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;

    margin: 1.1rem auto 0;

    color: #b48a5a;

    opacity: 0.55;

}

.envelope__paper-line span {

    width: 34px;
    height: 1px;

    background: currentColor;

    display: inline-block;

}

.envelope__paper-line-dot {

    width: 7px;
    height: 7px;

}

/* Esquinas decorativas del papel */

.envelope__paper-corner {

    position: absolute;

    width: 14px;
    height: 14px;

    border: 1px solid rgba(180, 138, 90, 0.35);

    opacity: calc(var(--progress) * 0.9);

    transition: opacity 0.6s ease 0.15s;

    pointer-events: none;

}

.envelope__paper-corner--tl { top: 14px; left: 14px; border-right: none; border-bottom: none; }
.envelope__paper-corner--tr { top: 14px; right: 14px; border-left: none; border-bottom: none; }
.envelope__paper-corner--bl { bottom: 14px; left: 14px; border-right: none; border-top: none; }
.envelope__paper-corner--br { bottom: 14px; right: 14px; border-left: none; border-top: none; }

/* ========================================
   CUERPO DEL SOBRE
======================================== */

.envelope__body {

    position: absolute;

    bottom: 0;
    left: var(--envelope-left);

    width: var(--envelope-width);
    height: var(--envelope-height);

    z-index: 2;

    overflow: hidden;

    background:

        linear-gradient(
            145deg,
            #f6efe1 0%,
            #efe4d2 50%,
            #e5d6bf 100%
        );

    border: 1px solid rgba(130, 100, 60, 0.18);

    border-radius: 6px;

    box-shadow:

        0 10px 20px rgba(60, 40, 20, 0.06),
        0 28px 55px rgba(40, 25, 15, 0.18),
        0 2px 0 rgba(255, 255, 255, 0.5) inset;

}

.envelope__texture {

    position: absolute;

    inset: 0;

    opacity: 0.4;

    mix-blend-mode: multiply;

    pointer-events: none;

    background-image:
        repeating-linear-gradient(
            125deg,
            rgba(140, 108, 68, 0.035) 0px,
            rgba(140, 108, 68, 0.035) 1px,
            transparent 1px,
            transparent 3px
        );

}

/* Pliegues diagonales (solapas laterales) */

.envelope__side {

    position: absolute;

    top: 0;

    width: 52%;

    height: 100%;

    background:
        linear-gradient(
            180deg,
            rgba(255, 255, 255, 0.18),
            transparent 55%
        );

    opacity: 0.55;

    pointer-events: none;

}

.envelope__side--left {

    left: -2%;

    clip-path: polygon(0 0, 100% 50%, 0 100%);

    background:
        linear-gradient(100deg, rgba(150, 115, 75, 0.10), transparent 60%);

}

.envelope__side--right {

    right: -2%;

    clip-path: polygon(100% 0, 0 50%, 100% 100%);

    background:
        linear-gradient(260deg, rgba(150, 115, 75, 0.10), transparent 60%);

}

.envelope__pocket-shadow {

    position: absolute;

    inset: 0;

    background:
        linear-gradient(
            180deg,
            transparent 55%,
            rgba(70, 48, 24, 0.10) 100%
        );

    pointer-events: none;

}

.envelope__rim {

    position: absolute;

    inset: 0;

    border-radius: 6px;

    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.25);

    pointer-events: none;

}

/* Sombra interna (se desvanece al abrir) */

.envelope__inner-shadow {

    position: absolute;

    inset: 0;

    background:

        linear-gradient(
            180deg,
            rgba(80, 55, 30, 0.14),
            transparent 32%
        );

    opacity:

        calc(
            1 - var(--progress)
        );

    transition: opacity 0.45s ease;

    pointer-events: none;

}

/* ========================================
   SOLAPA
======================================== */

.envelope__flap {

    position: absolute;

    top: 22%;
    left: var(--envelope-left);

    width: var(--envelope-width);
    height: 56%;

    z-index: 3;

    transform-origin: top center;

    transform:

        rotateX(
            calc(
                -128deg * var(--progress)
            )
        );

    transform-style: preserve-3d;

    backface-visibility: visible;

    background:

        linear-gradient(
            180deg,
            #fbf4e6 0%,
            #efe3cf 46%,
            #ddccae 100%
        );

    clip-path:

        polygon(
            0 0,
            100% 0,
            50% 100%
        );

    box-shadow:

        0 12px 25px rgba(70, 45, 20, calc(0.10 + 0.08 * var(--progress)));

    transition:
        filter 0.4s ease,
        box-shadow 0.5s ease;

    will-change: transform;

}

/* Interior de la solapa */

.envelope__flap-inner {

    position: absolute;

    inset: 0;

    background:

        linear-gradient(
            180deg,
            rgba(255, 255, 255, 0.26),
            transparent 65%
        );

    opacity: 0.85;

    pointer-events: none;

}

.envelope__flap-edge {

    position: absolute;

    inset: 0;

    box-shadow: inset 0 0 0 1px rgba(150, 115, 75, 0.18);

    pointer-events: none;

}

/* ========================================
   SELLO DE CERA
======================================== */

.envelope__seal {

    position: absolute;

    top: 55%;
    left: 50%;

    width: clamp(50px, 14vw, 64px);
    height: clamp(50px, 14vw, 64px);

    border-radius: 50%;

    display: grid;
    place-items: center;

    background:

        radial-gradient(
            circle at 30% 24%,
            #dcb684 0%,
            #b78c5c 38%,
            #8f6a40 75%,
            #7a5730 100%
        );

    color: #fff9ee;

    font-family: var(--font-display);

    font-size: clamp(.72rem, 2.5vw, .86rem);

    letter-spacing: .12em;

    z-index: 4;

    transform:

        translate(-50%, -50%)

        scale(
            calc(
                1 - (.55 * var(--progress))
            )
        )

        rotate(
            calc(
                -10deg + (10deg * var(--progress))
            )
        );

    opacity:

        clamp(
            0,
            calc(
                1 - (var(--progress) * 2.4)
            ),
            1
        );

    box-shadow:

        0 4px 8px rgba(80, 45, 20, 0.20),
        0 8px 18px rgba(80, 45, 20, 0.14),
        inset 2px 2px 4px rgba(255, 255, 255, 0.22),
        inset -2px -2px 5px rgba(60, 30, 12, 0.28);

    transition:
        box-shadow 0.35s ease;

    will-change: transform, opacity;

}

.envelope__seal span {

    position: relative;

    z-index: 1;

    text-shadow: 0 1px 1px rgba(60, 30, 10, 0.4);

}

/* Goterón de cera bajando del sello */

.envelope__seal-drip {

    position: absolute;

    top: 92%;
    left: 50%;

    width: 9px;
    height: 16px;

    background: linear-gradient(180deg, #b78c5c, #8f6a40);

    border-radius: 0 0 50% 50% / 0 0 60% 60%;

    transform: translateX(-50%);

    opacity: 0.85;

    z-index: 0;

}

.envelope__seal-ring {

    position: absolute;

    inset: 0;

    pointer-events: none;

}

/* Grieta que aparece justo al romperse el sello */

.envelope__seal-crack {

    position: absolute;

    inset: 0;

    border-radius: 50%;

    opacity: clamp(0, calc((var(--progress) - 0.02) * 12), 1);

    background:
        linear-gradient(105deg, transparent 46%, rgba(40, 22, 8, 0.5) 49%, transparent 52%),
        linear-gradient(15deg, transparent 60%, rgba(40, 22, 8, 0.35) 63%, transparent 66%);

    mix-blend-mode: multiply;

    pointer-events: none;

    transition: opacity 0.15s ease;

}

/* ========================================
   TEXTO
======================================== */

.envelope__text {

    position: relative;

    font-family: var(--font-display);

    font-size: clamp(.94rem, 3.3vw, 1.12rem);

    font-style: italic;

    font-weight: 500;

    text-align: center;

    line-height: 1.62;

    margin: 0 0 .7rem;

    text-wrap: balance;

    text-shadow: 0 1px 0 rgba(255, 255, 255, 0.5);

}

.envelope__text:last-of-type {

    margin-bottom: 0;

}

.envelope__text--intro {

    color: #b66d3d;

}

.envelope__text--body1 {

    color: #2c3a63;

}

.envelope__text--body2 {

    color: #4c5a34;

}

/* ========================================
   ESTADO ABIERTO
======================================== */

.envelope.is-open .envelope__letter {

    z-index: 5;

    box-shadow:

        0 1px 0 rgba(255, 255, 255, 0.6) inset,
        0 15px 30px rgba(40, 25, 15, 0.09),
        0 35px 65px rgba(40, 25, 15, 0.16);

}

.envelope.is-open .envelope__flap {

    z-index: 4;

}

/* ========================================
   RESPONSIVE
======================================== */

@media (max-width: 420px) {

    .envelope {

        --envelope-left: 5%;
        --envelope-width: 90%;

        height: clamp(390px, 112vw, 500px);

    }

    .envelope__letter {

        padding: 1.15rem;

    }

    .envelope__text {

        font-size: .93rem;
        line-height: 1.5;

    }

    .envelope__ornament {

        width: 64px;

    }

}

@media (prefers-reduced-motion: reduce) {

    .envelope__letter,
    .envelope__paper,
    .envelope__flap,
    .envelope__seal,
    .envelope__ambient,
    .envelope__floor-glow {

        transition: none;

    }

}

</style>

<script>

const envelope =
    document.querySelector<HTMLElement>('[data-envelope]');

const scene =
    document.querySelector<HTMLElement>('.scene');

if (envelope) {

    const envelopeElement = envelope;
    const sceneElement = scene;

    // Si el usuario le dio click/tap, "manualOverride" manda sobre el scroll
    // hasta que vuelva a scrollear de verdad; así el click no pelea con el
    // scroll-linked animation existente.
    let manualOverride: number | null = null;
    let animationTimeout: ReturnType<typeof setTimeout> | null = null;

    function applyProgress(progress: number) {

        envelopeElement.style.setProperty(
            '--progress',
            String(progress)
        );

        const isOpen = progress > 0.42;

        envelopeElement.classList.toggle('is-open', isOpen);

        envelopeElement.setAttribute(
            'aria-expanded',
            String(isOpen)
        );

    }

    function update() {

        if (manualOverride !== null || !sceneElement) {
            return;
        }

        const rect =
            sceneElement.getBoundingClientRect();

        const total =
            sceneElement.offsetHeight -
            window.innerHeight;

        const current =
            Math.min(
                total,
                Math.max(
                    0,
                    -rect.top
                )
            );

        const openingDistance =
            total * 0.55;

        let progress =
            openingDistance > 0
                ? current / openingDistance
                : 1;

        progress =
            Math.max(
                0,
                Math.min(
                    1,
                    progress
                )
            );

        applyProgress(progress);

    }

    function toggleEnvelope() {

        const isCurrentlyOpen =
            envelopeElement.classList.contains('is-open');

        const target = isCurrentlyOpen ? 0 : 1;

        manualOverride = target;

        envelopeElement.classList.add('is-animating');

        applyProgress(target);

        if (animationTimeout) {
            clearTimeout(animationTimeout);
        }

        animationTimeout = setTimeout(() => {
            envelopeElement.classList.remove('is-animating');
        }, 900);

    }

    envelopeElement.setAttribute('role', 'button');
    envelopeElement.setAttribute('tabindex', '0');
    envelopeElement.setAttribute('aria-label', 'Abrir o cerrar el sobre');
    envelopeElement.setAttribute('aria-expanded', 'false');

    envelopeElement.addEventListener('click', toggleEnvelope);

    envelopeElement.addEventListener('keydown', (event) => {

        if (event.key === 'Enter' || event.key === ' ') {
            event.preventDefault();
            toggleEnvelope();
        }

    });

    if (sceneElement) {

        window.addEventListener(
            'scroll',
            () => {
                // un scroll real le devuelve el control a la animación de scroll
                manualOverride = null;
                update();
            },
            { passive: true }
        );

        window.addEventListener(
            'resize',
            update
        );

        update();

    }

}

</script>