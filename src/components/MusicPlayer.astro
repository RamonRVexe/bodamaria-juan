<div class="music-player" data-music-player>
  <audio data-music-audio autoplay loop preload="auto">
    <source src="/audio/cancion-boda.mp3" type="audio/mpeg" />
  </audio>

  <button
    class="music-player__button"
    type="button"
    data-music-toggle
    aria-label="Activar música"
    title="Activar música"
    aria-pressed="false"
  >
    <span class="music-player__icon" data-music-icon aria-hidden="true">♪</span>
  </button>
</div>

<script>
  const players = document.querySelectorAll<HTMLElement>('[data-music-player]');

  players.forEach((player) => {
    const audio = player.querySelector<HTMLAudioElement>('[data-music-audio]');
    const toggle = player.querySelector<HTMLButtonElement>('[data-music-toggle]');
    const icon = player.querySelector<HTMLElement>('[data-music-icon]');

    if (!audio || !toggle || !icon) return;

    const audioElement = audio;
    const toggleElement = toggle;
    const iconElement = icon;

    audioElement.volume = 0.13;

    function updateButton(isPlaying: boolean) {
      toggleElement.setAttribute('aria-pressed', String(isPlaying));
      const label = isPlaying ? 'Silenciar música' : 'Activar música';
      toggleElement.setAttribute('aria-label', label);
      toggleElement.setAttribute('title', label);
      iconElement.textContent = isPlaying ? '♫' : '♪';
      player.classList.toggle('is-playing', isPlaying);
    }

    async function playMusic() {
      try {
        await audioElement.play();
        updateButton(true);
      } catch {
        updateButton(false);
      }
    }

    toggleElement.addEventListener('click', () => {
      if (audioElement.paused) {
        void playMusic();
      } else {
        audioElement.pause();
        updateButton(false);
      }
    });

    audioElement.addEventListener('play', () => updateButton(true));
    audioElement.addEventListener('pause', () => updateButton(false));
    audioElement.addEventListener('error', () => updateButton(false));

    const startAfterInteraction = () => {
      void playMusic();
      document.removeEventListener('pointerdown', startAfterInteraction);
      document.removeEventListener('keydown', startAfterInteraction);
    };

    document.addEventListener('pointerdown', startAfterInteraction, { once: true });
    document.addEventListener('keydown', startAfterInteraction, { once: true });

    updateButton(false);
    void playMusic();
  });
</script>

<style>
  .music-player {
    position: fixed;
    right: max(1rem, env(safe-area-inset-right));
    bottom: max(1rem, env(safe-area-inset-bottom));
    z-index: 20;
  }

  .music-player__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    padding: 0;
    border: 1px solid rgba(247, 242, 231, 0.45);
    border-radius: 999px;
    background: rgba(43, 51, 36, 0.88);
    color: var(--paper);
    box-shadow: 0 10px 28px rgba(20, 22, 15, 0.25);
    transition: background-color 220ms ease, transform 220ms ease;
    backdrop-filter: blur(8px);
  }

  .music-player__button:hover {
    background: var(--forest);
  }

  .music-player__button:active {
    transform: scale(0.96);
  }

  .music-player__icon {
    display: grid;
    place-items: center;
    width: 1.2rem;
    height: 1.2rem;
    font-family: var(--font-display);
    font-size: 1.25rem;
    line-height: 1;
  }

  .music-player.is-playing .music-player__icon {
    animation: music-pulse 1.4s ease-in-out infinite;
  }

  @keyframes music-pulse {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-2px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .music-player.is-playing .music-player__icon {
      animation: none;
    }
  }
</style>
